def write_gene_tree_analysis_scripts(combo_root, project_prefix):
    copy_progress_monitor(combo_root)
    write_executable_script(
        combo_root / "01_run_iqtree_gene_trees.sh",
        """#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "${SCRIPT_DIR}"

IQTREE_BIN="${IQTREE_BIN:-iqtree}"
JOBS="${1:-${JOBS:-}}"
THREADS_PER_JOB="${2:-${THREADS_PER_JOB:-}}"
MODEL="${3:-${MODEL:-}}"
BOOTSTRAPS="${4:-${BOOTSTRAPS:-}}"
EXTRA_IQTREE_ARGS="${5:-${EXTRA_IQTREE_ARGS:-}}"
if [[ -t 0 ]]; then
  read -r -p "Concurrent IQ-TREE jobs [${JOBS:-72}]: " value; JOBS="${value:-${JOBS:-72}}"
  read -r -p "Threads per job [${THREADS_PER_JOB:-1}]: " value; THREADS_PER_JOB="${value:-${THREADS_PER_JOB:-1}}"
  read -r -p "IQ-TREE model [${MODEL:-MFP}]: " value; MODEL="${value:-${MODEL:-MFP}}"
  read -r -p "Ultrafast bootstrap replicates [${BOOTSTRAPS:-1000}]: " value; BOOTSTRAPS="${value:-${BOOTSTRAPS:-1000}}"
  read -r -p "Additional IQ-TREE arguments [${EXTRA_IQTREE_ARGS}]: " value; EXTRA_IQTREE_ARGS="${value:-${EXTRA_IQTREE_ARGS}}"
else
  JOBS="${JOBS:-72}"; THREADS_PER_JOB="${THREADS_PER_JOB:-1}"
  MODEL="${MODEL:-MFP}"; BOOTSTRAPS="${BOOTSTRAPS:-1000}"
fi
echo "Using JOBS=${JOBS}, THREADS_PER_JOB=${THREADS_PER_JOB} (total threads: $((JOBS * THREADS_PER_JOB))), MODEL=${MODEL}, BOOTSTRAPS=${BOOTSTRAPS}"
ALIGNMENT_DIR="alignments"
OUTDIR="iqtree_gene_trees"

command -v "${IQTREE_BIN}" >/dev/null 2>&1 || {
  echo "ERROR: IQ-TREE executable not found: ${IQTREE_BIN}" >&2
  exit 1
}

if [ ! -d "${ALIGNMENT_DIR}" ]; then
  echo "ERROR: Missing alignment directory: ${ALIGNMENT_DIR}" >&2
  exit 1
fi

ALIGNMENT_COUNT="$(find "${ALIGNMENT_DIR}" -maxdepth 1 -type f -name "*.fasta" | wc -l | tr -d " ")"
if [ "${ALIGNMENT_COUNT}" -eq 0 ]; then
  echo "ERROR: No .fasta alignments found under ${ALIGNMENT_DIR}" >&2
  exit 1
fi

mkdir -p "${OUTDIR}"

PROGRESS_STATUS="${OUTDIR}/.progress_status"
""" + progress_status_setup() + """
if [[ "${IQTREE_PROGRESS:-1}" != "0" ]]; then
  bash ./watch_iqtree_progress_htop.sh --launch "${OUTDIR}" "${IQTREE_PROGRESS_INTERVAL:-60}" "${ALIGNMENT_COUNT}" "$PROGRESS_STATUS" || true
fi

find "${ALIGNMENT_DIR}" -maxdepth 1 -type f -name "*.fasta" -print0 | sort -z | \
  xargs -0 -n 1 -P "${JOBS}" bash -c '
    set -euo pipefail
    outdir="$1"
    iqtree_bin="$2"
    threads="$3"
    model="$4"
    bootstraps="$5"
    extra_args="$6"
    aln="$7"
    base="$(basename "$aln" .fasta)"
    prefix="${outdir}/${base}"
    if [ -s "${prefix}.treefile" ]; then
      echo "Skipping ${base}; ${prefix}.treefile already exists."
      exit 0
    fi
    "${iqtree_bin}" -s "${aln}" -m "${model}" -B "${bootstraps}" \
