#!/usr/bin/env python3

import argparse
import csv
import shlex
import shutil
from collections import OrderedDict
from pathlib import Path


DATASET_CHOICES = ("complete", "incomplete")
BRANCH_CHOICES = ("supermatrix", "gene-tree")
PROJECT_INFO_NAME = "project.info"


def get_args():
    parser = argparse.ArgumentParser(
        description=(
            "Dispatch finalized Stage 11 locus alignments into supermatrix and/or "
            "gene-tree analysis branches."
        )
    )
    parser.add_argument("--input-dir", required=True, help="Stage 11 directory.")
    parser.add_argument(
        "--aggregated-loci",
        required=True,
        help="Stage 07 aggregated long-format loci table used to recover all sample IDs.",
    )
    parser.add_argument("--output-dir", required=True, help="Directory for Stage 12 analysis branches.")
    parser.add_argument(
        "--threshold-groups",
        default=None,
        help=(
            "Optional dataset modes or threshold-group labels to process. Accepts "
            "'complete', 'incomplete', 'all', or specific Stage 11 threshold_group labels."
        ),
    )
    parser.add_argument(
        "--filter-labels",
        default=None,
        help=(
            "Optional comma-separated filter labels or values to process, e.g. "
            "'complete_matrix,min_taxa_075' or '1.0,0.75'. Defaults to all."
        ),
    )
    parser.add_argument(
        "--analysis-branches",
        default="both",
        help="Analysis branches to produce: 'supermatrix', 'gene-tree', or 'both'.",
    )
    parser.add_argument(
        "--missing-character",
        default="?",
        help="Character to use for missing data designators in the supermatrix branch.",
    )
    return parser.parse_args()


def parse_fasta(path):
    records = OrderedDict()
    current = None
    chunks = []
    with open(path) as handle:
        for raw in handle:
            line = raw.strip()
            if not line:
                continue
            if line.startswith(">"):
                if current is not None:
                    records[current] = "".join(chunks)
                current = line[1:].split()[0]
                chunks = []
            else:
                chunks.append(line)
    if current is not None:
        records[current] = "".join(chunks)
    return records


def write_fasta(path, records):
    with open(path, "w") as handle:
        for header, seq in records.items():
            handle.write(">{}\n".format(header))
            handle.write("{}\n".format(seq))


def normalize_fasta_copy(input_path, output_path):
    records = parse_fasta(input_path)
    output_path.parent.mkdir(parents=True, exist_ok=True)
    write_fasta(output_path, records)


def normalize_taxon_name(name):
    while name.startswith("_R_"):
        name = name[3:]
    return name.split("|")[0]


def normalize_gene_tree_fasta_copy(input_path, output_path):
    records = parse_fasta(input_path)
    normalized = OrderedDict()
    for header, seq in records.items():
        taxon = normalize_taxon_name(header)
        if not taxon:
            raise RuntimeError("Empty normalized taxon name in {}".format(input_path))
        if taxon in normalized:
            raise RuntimeError(
                "Duplicate normalized taxon name {} in {}".format(taxon, input_path)
            )
        normalized[taxon] = seq
    output_path.parent.mkdir(parents=True, exist_ok=True)
    write_fasta(output_path, normalized)


def derive_all_taxa_from_alignments(fasta_files):
    taxa = []
    seen = set()
    for fasta_path in fasta_files:
        for header in parse_fasta(fasta_path):
            sample_id = normalize_taxon_name(header)
            if sample_id and sample_id not in seen:
                seen.add(sample_id)
                taxa.append(sample_id)
    if not taxa:
        raise RuntimeError("No taxa found across Stage 11 alignments.")
    return sorted(taxa)


def parse_analysis_branches(text):
    value = (text or "both").strip().lower()
    if value == "both":
        return list(BRANCH_CHOICES)
    branches = []
    seen = set()
    for item in value.split(","):
        branch = item.strip().lower()
        if not branch:
            continue
        if branch not in BRANCH_CHOICES:
            raise RuntimeError(
                "Unsupported analysis branch: {}. Expected one of {}".format(
                    branch, ", ".join(BRANCH_CHOICES + ("both",))
                )
            )
        if branch not in seen:
            seen.add(branch)
            branches.append(branch)
    if not branches:
        raise RuntimeError("No valid analysis branches were provided.")
    return branches


def read_all_taxa(aggregated_loci):
    taxa = []
    seen = set()
    with open(aggregated_loci, newline="") as handle:
        reader = csv.DictReader(handle, delimiter="\t")
        if reader.fieldnames is None or "sample_id" not in reader.fieldnames:
            raise RuntimeError("Unexpected aggregated loci schema in {}".format(aggregated_loci))
        for row in reader:
            sample_id = row["sample_id"].strip()
            if sample_id and sample_id not in seen:
                seen.add(sample_id)
                taxa.append(sample_id)
    if not taxa:
        raise RuntimeError("No sample_id values found in {}".format(aggregated_loci))
    return sorted(taxa)


def filter_label_from_value(value):
    threshold = float(value)
    if threshold <= 0 or threshold > 1:
        raise RuntimeError("Filter label values must be > 0 and <= 1: {}".format(value))
    if abs(threshold - 1.0) < 1e-9:
        return "complete_matrix"
    return "min_taxa_{:03d}".format(int(round(threshold * 100)))


def parse_filter_labels(requested):
    if not requested or str(requested).strip().lower() == "all":
        return None
    labels = []
    seen = set()
    for item in requested.split(","):
        value = item.strip()
        if not value:
            continue
        label = value if value == "complete_matrix" or value.startswith("min_taxa_") else filter_label_from_value(value)
        if label not in seen:
            seen.add(label)
            labels.append(label)
    if not labels:
        raise RuntimeError("No valid filter labels were provided.")
    return labels


def parse_threshold_groups(requested):
    if not requested or str(requested).strip().lower() == "all":
        return None, None
    dataset_modes = []
    dataset_seen = set()
    threshold_groups = []
    group_seen = set()
    for item in requested.split(","):
        value = item.strip()
        if not value:
            continue
        if value in DATASET_CHOICES:
            if value not in dataset_seen:
                dataset_seen.add(value)
                dataset_modes.append(value)
        else:
            if value not in group_seen:
                group_seen.add(value)
                threshold_groups.append(value)
    if not dataset_modes and not threshold_groups:
        raise RuntimeError("No valid threshold groups were provided.")
    return dataset_modes or None, threshold_groups or None


def read_stage11_manifest(input_dir):
    manifest_path = Path(input_dir).resolve() / "threshold_manifest.tsv"
    if not manifest_path.is_file():
        raise RuntimeError("Missing Stage 11 manifest: {}".format(manifest_path))
    rows = []
    with open(manifest_path, newline="") as handle:
        reader = csv.DictReader(handle, delimiter="\t")
        required = {
            "trim_mode",
            "dataset_label",
            "threshold_group",
            "completeness_threshold",
            "filter_label",
            "output_dir",
        }
        if reader.fieldnames is None or not required.issubset(set(reader.fieldnames)):
            raise RuntimeError("Unexpected Stage 11 manifest schema in {}".format(manifest_path))
        for row in reader:
            rows.append(
                {
                    "trim_mode": row["trim_mode"].strip(),
                    "dataset_label": row["dataset_label"].strip(),
                    "threshold_group": row["threshold_group"].strip(),
                    "completeness_threshold": row["completeness_threshold"].strip(),
                    "filter_label": row["filter_label"].strip(),
                    "output_dir": row["output_dir"].strip(),
                }
            )
    if not rows:
        raise RuntimeError("No rows found in {}".format(manifest_path))
    return rows


def select_stage11_rows(rows, requested_datasets, requested_threshold_groups, requested_filter_labels):
    selected = []
    seen = set()
    for row in rows:
        if requested_datasets is not None and row["dataset_label"] not in requested_datasets:
            if requested_threshold_groups is None or row["threshold_group"] not in requested_threshold_groups:
                continue
        elif requested_threshold_groups is not None and row["threshold_group"] not in requested_threshold_groups and row["dataset_label"] not in requested_threshold_groups:
            continue
        if requested_filter_labels is not None and row["filter_label"] not in requested_filter_labels:
            continue
        key = (
            row["trim_mode"],
            row["dataset_label"],
            row["threshold_group"],
            row["filter_label"],
            row["output_dir"],
        )
        if key in seen:
            continue
        seen.add(key)
        selected.append(row)
    if not selected:
        raise RuntimeError("No Stage 11 result combinations matched the requested filters.")
    return selected


def discover_alignments(combo_output_dir):
    alignments_dir = Path(combo_output_dir).resolve() / "alignments"
    if not alignments_dir.is_dir():
        raise RuntimeError("Missing alignments directory: {}".format(alignments_dir))
    files = sorted(alignments_dir.glob("*.fasta"))
    if not files:
        raise RuntimeError("No alignment FASTA files found under {}".format(alignments_dir))
    return files


def complete_alignment(fasta_path, output_path, all_taxa, missing_character):
    records = parse_fasta(fasta_path)
    normalized = OrderedDict()
    for header, seq in records.items():
        norm = normalize_taxon_name(header)
        if norm in normalized:
            raise RuntimeError(
                "Duplicate normalized taxon name {} in {}".format(norm, fasta_path)
            )
        normalized[norm] = seq
    lengths = {len(seq) for seq in normalized.values()}
    if len(lengths) != 1:
        raise RuntimeError("Alignment has inconsistent sequence lengths: {}".format(fasta_path))
    alignment_length = next(iter(lengths)) if lengths else 0
    missing_seq = missing_character * alignment_length
    completed = OrderedDict()
    added = []
    for taxon in all_taxa:
        if taxon in normalized:
            completed[taxon] = normalized[taxon]
        else:
            completed[taxon] = missing_seq
            added.append(taxon)
    output_path.parent.mkdir(parents=True, exist_ok=True)
    write_fasta(output_path, completed)
    return {
        "input_taxa": len(normalized),
        "output_taxa": len(completed),
        "alignment_length": alignment_length,
        "added_taxa_count": len(added),
        "added_taxa_ids": ",".join(added),
    }


def write_phylip_relaxed(path, records):
    taxa = len(records)
    length = len(next(iter(records.values()))) if records else 0
    with open(path, "w") as handle:
        handle.write("{} {}\n".format(taxa, length))
        for header, seq in records.items():
            handle.write("{} {}\n".format(header, seq))


def nexus_escape_label(label):
    safe = str(label).replace("'", "''")
    return "'{}'".format(safe)


def write_nexus(path, records, partitions):
    taxa = len(records)
    nchar = len(next(iter(records.values()))) if records else 0
    with open(path, "w") as handle:
        handle.write("#NEXUS\n\n")
        handle.write("BEGIN DATA;\n")
        handle.write("    DIMENSIONS NTAX={} NCHAR={};\n".format(taxa, nchar))
        handle.write("    FORMAT DATATYPE=DNA MISSING=? GAP=-;\n")
        handle.write("    MATRIX\n")
        for header, seq in records.items():
            handle.write("    {} {}\n".format(nexus_escape_label(header), seq))
        handle.write("    ;\n")
        handle.write("END;\n\n")
        handle.write("BEGIN SETS;\n")
        for row in partitions:
            handle.write(
                "    CHARSET {} = {}-{};\n".format(
                    row["locus"], row["start"], row["end"]
                )
            )
        handle.write("END;\n")


def write_charset_nexus(path, partitions):
    with open(path, "w") as handle:
        handle.write("#NEXUS\n\n")
        handle.write("BEGIN SETS;\n")
        for row in partitions:
            handle.write(
                "    CHARSET {} = {}-{};\n".format(
                    row["locus"], row["start"], row["end"]
                )
            )
        handle.write("END;\n")


def read_project_id_from_info(path):
    info_path = Path(path) / PROJECT_INFO_NAME
    if not info_path.is_file():
        return None
    with open(info_path) as handle:
        for line in handle:
            line = line.rstrip("\n")
            if not line or "\t" not in line:
                continue
            key, value = line.split("\t", 1)
            if key == "project_id" and value:
                return value
    return None


def project_prefix_from_project_info(*paths):
    candidates = []
    for path in paths:
        current = Path(path).resolve()
        candidates.append(current)
        candidates.extend(current.parents)
    seen = set()
    for candidate in candidates:
        if candidate in seen:
            continue
        seen.add(candidate)
        project_id = read_project_id_from_info(candidate)
        if project_id:
            return project_id
    return None


def project_prefix_from_aggregated_loci(path):
    name = Path(path).name
    suffix = ".filtered.loci.tsv"
    if name.endswith(suffix):
        return name[: -len(suffix)]
    return Path(name).stem


def resolve_project_prefix(input_dir, output_dir, aggregated_loci):
    return (
        project_prefix_from_project_info(output_dir, input_dir, aggregated_loci)
        or project_prefix_from_aggregated_loci(aggregated_loci)
    )


def write_iqtree_script(path, phylip_path, charset_path, project_prefix):
    copy_progress_monitor(path.parent)
    iqtree_prefix = "{}_{}".format(project_prefix, phylip_path.stem)
    command = [
        "iqtree",
        "-s",
        "./{}".format(phylip_path.name),
        "-p",
        "./{}".format(charset_path.name),
        "-m",
        "MFP+MERGE",
        "-rcluster",
        "10",
        "-T",
        "AUTO",
        "-B",
        "1000",
        "--prefix",
        "./{}".format(iqtree_prefix),
    ]
    with open(path, "w") as handle:
        handle.write("#!/usr/bin/env bash\n")
        handle.write("set -euo pipefail\n\n")
        handle.write('SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"\ncd "${SCRIPT_DIR}"\n\n')
        handle.write("PROGRESS_STATUS={}\n".format(shlex.quote("./" + iqtree_prefix + ".progress_status")))
        handle.write(progress_status_setup())
        handle.write('if [[ "${IQTREE_PROGRESS:-1}" != "0" ]]; then\n')
        handle.write('  bash ./watch_iqtree_progress_htop.sh --launch {} "${{IQTREE_PROGRESS_INTERVAL:-60}}" 0 "$PROGRESS_STATUS" || true\n'.format(shlex.quote("./" + iqtree_prefix + ".log")))
        handle.write("fi\n\n")
        handle.write("{}\n".format(" ".join(shlex.quote(part) for part in command)))
    path.chmod(0o755)


def write_executable_script(path, content):
    with open(path, "w") as handle:
        handle.write(content)
    path.chmod(0o755)


def copy_progress_monitor(directory):
    source = Path(__file__).resolve().parent / "watch_iqtree_progress_htop.sh"
    destination = Path(directory) / source.name
    shutil.copyfile(source, destination)
    destination.chmod(0o755)


def write_gene_tree_validator(directory):
    write_executable_script(
        Path(directory) / "validate_gene_trees.py",
        r'''#!/usr/bin/env python3
import argparse
import math
import sys
from pathlib import Path


class NewickError(ValueError):
    pass


class NewickParser:
    delimiters = set("(),:;")
    forbidden_label_characters = set("'\"?[]")

    def __init__(self, text):
        self.text = text
        self.pos = 0
        self.leaves = []

    def error(self, message):
        start = max(0, self.pos - 20)
        end = min(len(self.text), self.pos + 20)
        context = self.text[start:end]
        raise NewickError("{} near character {}: {!r}".format(message, self.pos + 1, context))

    def skip_space(self):
        while self.pos < len(self.text) and self.text[self.pos].isspace():
            self.pos += 1

    def parse_label(self, required):
        self.skip_space()
        start = self.pos
        while self.pos < len(self.text):
            char = self.text[self.pos]
            if char in self.delimiters or char.isspace():
                break
            self.pos += 1
        label = self.text[start:self.pos]
        if required and not label:
            self.error("taxon label expected")
        if any(char in self.forbidden_label_characters for char in label):
            self.error("ASTRAL-incompatible character in label")
        return label

    def parse_length(self):
        self.skip_space()
        if self.pos >= len(self.text) or self.text[self.pos] != ":":
            return
        self.pos += 1
        self.skip_space()
        start = self.pos
        while self.pos < len(self.text):
            char = self.text[self.pos]
            if char in ",);" or char.isspace():
                break
            self.pos += 1
        token = self.text[start:self.pos]
        if not token:
            self.error("branch length expected")
        try:
            value = float(token)
        except ValueError:
            self.error("invalid branch length {!r}".format(token))
        if not math.isfinite(value):
            self.error("non-finite branch length {!r}".format(token))

    def parse_subtree(self):
        self.skip_space()
        if self.pos >= len(self.text):
            self.error("subtree expected")
        if self.text[self.pos] == "(":
            self.pos += 1
            child_count = 0
            while True:
                self.parse_subtree()
                child_count += 1
                self.skip_space()
                if self.pos < len(self.text) and self.text[self.pos] == ",":
                    self.pos += 1
                    continue
                break
            if child_count < 2:
                self.error("an internal node must have at least two children")
            if self.pos >= len(self.text) or self.text[self.pos] != ")":
                self.error("')' expected")
            self.pos += 1
            self.parse_label(required=False)
            self.parse_length()
        else:
            label = self.parse_label(required=True)
            self.leaves.append(label)
            self.parse_length()

    def parse(self):
        self.parse_subtree()
        self.skip_space()
        if self.pos >= len(self.text) or self.text[self.pos] != ";":
            self.error("';' expected")
        self.pos += 1
        self.skip_space()
        if self.pos != len(self.text):
            self.error("unexpected content after ';'")
        seen = set()
        duplicates = []
        for label in self.leaves:
            if label in seen and label not in duplicates:
                duplicates.append(label)
            seen.add(label)
        if duplicates:
            raise NewickError(
                "duplicate taxon label(s): {}".format(", ".join(duplicates[:10]))
            )


INFORMATIVE_NUCLEOTIDES = set("ACGTURYSWKMBDHV")


def main():
    parser = argparse.ArgumentParser(
        description="Validate one-tree-per-line Newick input before ASTRAL."
    )
    parser.add_argument("path")
    parser.add_argument("--single", action="store_true")
    parser.add_argument("--expected-count", type=int)
    parser.add_argument(
        "--alignment",
        help=(
            "Require every FASTA taxon with informative nucleotide data to occur "
            "in the single tree; all-missing taxa may be absent."
        ),
    )
    args = parser.parse_args()

    path = Path(args.path)
    if not path.is_file():
        parser.error("file not found: {}".format(path))
    lines = [
        (number, line.strip())
        for number, line in enumerate(path.read_text().splitlines(), 1)
        if line.strip()
    ]
    errors = []
    if args.single and len(lines) != 1:
        errors.append("expected exactly one non-empty tree line, found {}".format(len(lines)))
    if args.expected_count is not None and len(lines) != args.expected_count:
        errors.append(
            "expected {} non-empty tree lines, found {}".format(
                args.expected_count, len(lines)
            )
        )
    if not lines:
        errors.append("no non-empty gene trees found")
    expected_leaves = None
    allowed_leaves = None
    if args.alignment:
        alignment = Path(args.alignment)
        if not alignment.is_file():
            errors.append("alignment file not found: {}".format(alignment))
        else:
            records = []
            current_label = None
            sequence = []
            for raw in alignment.read_text().splitlines():
                line = raw.strip()
                if not line:
                    continue
                if line.startswith(">"):
                    if current_label is not None:
                        records.append((current_label, "".join(sequence)))
                    label = raw[1:].strip().split()[0]
                    current_label = label
                    sequence = []
                elif current_label is None:
                    errors.append("alignment sequence appears before the first FASTA header")
                else:
                    sequence.append(line)
            if current_label is not None:
                records.append((current_label, "".join(sequence)))
            all_alignment_leaves = [label for label, sequence in records]
            if len(all_alignment_leaves) != len(set(all_alignment_leaves)):
                errors.append("alignment contains duplicate FASTA headers")
            allowed_leaves = set(all_alignment_leaves)
            expected_leaves = {
                label
                for label, sequence in records
                if any(base.upper() in INFORMATIVE_NUCLEOTIDES for base in sequence)
            }
            if len(lines) != 1:
                errors.append("--alignment requires exactly one gene tree")

    for line_number, tree in lines:
        try:
            newick = NewickParser(tree)
            newick.parse()
            if expected_leaves is not None:
                tree_leaves = set(newick.leaves)
                missing = sorted(expected_leaves - tree_leaves)
                extra = sorted(tree_leaves - allowed_leaves)
                if missing or extra:
                    raise NewickError(
                        "tree/alignment taxon mismatch; missing={} extra={}".format(
                            ",".join(missing[:10]) or "none",
                            ",".join(extra[:10]) or "none",
                        )
                    )
        except NewickError as error:
            errors.append("line {}: {}".format(line_number, error))
            if len(errors) >= 20:
                errors.append("stopped after 20 errors")
                break

    if errors:
        for error in errors:
            print("ERROR: {}: {}".format(path, error), file=sys.stderr)
        raise SystemExit(1)
    print("Validated {} gene tree(s) in {}".format(len(lines), path))


if __name__ == "__main__":
    main()
''',
    )


def progress_status_setup():
    return """printf 'RUNNING\\n' > "$PROGRESS_STATUS"
progress_exit() {
  local code=$?
  if (( code == 0 )); then
    printf 'FINISHED\\n' > "$PROGRESS_STATUS"
  else
    printf 'FAILED (exit %s)\\n' "$code" > "$PROGRESS_STATUS"
  fi
}
trap progress_exit EXIT
"""


