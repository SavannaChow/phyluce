def concatenate_alignments(alignments_dir, output_root, output_prefix, project_prefix):
    files = sorted(Path(alignments_dir).glob("*.fasta"))
    if not files:
        raise RuntimeError("No alignment FASTA files found under {}".format(alignments_dir))
    taxa_order = None
    concatenated = OrderedDict()
    partitions = []
    start = 1
    for fasta_path in files:
        records = parse_fasta(fasta_path)
        current_taxa = list(records.keys())
        if taxa_order is None:
            taxa_order = current_taxa
            concatenated = OrderedDict((taxon, "") for taxon in taxa_order)
        elif current_taxa != taxa_order:
            raise RuntimeError(
                "Inconsistent taxon order or taxon set in {}".format(fasta_path)
            )
        lengths = {len(seq) for seq in records.values()}
        if len(lengths) != 1:
            raise RuntimeError("Inconsistent sequence lengths in {}".format(fasta_path))
        locus_length = next(iter(lengths)) if lengths else 0
        end = start + locus_length - 1
        partitions.append(
            {
                "locus": fasta_path.stem,
                "start": start,
                "end": end,
                "length": locus_length,
            }
        )
        for taxon in taxa_order:
            concatenated[taxon] += records[taxon]
        start = end + 1

    output_root.mkdir(parents=True, exist_ok=True)
    raxml_root = output_root / "raxml_iqtree"
    mrbayes_root = output_root / "mrbayes"
    raxml_root.mkdir(parents=True, exist_ok=True)
    mrbayes_root.mkdir(parents=True, exist_ok=True)

    fasta_out = raxml_root / "{}.fasta".format(output_prefix)
    phylip_out = raxml_root / "{}.phylip".format(output_prefix)
    charset_tsv_out = raxml_root / "{}.charsets.tsv".format(output_prefix)
    charset_plain_out = raxml_root / "{}.charsets".format(output_prefix)
    charset_nexus_out = raxml_root / "{}.charsets.nexus".format(output_prefix)
    partition_plain_out = raxml_root / "{}.partitions".format(output_prefix)
    iqtree_script_out = raxml_root / "run_iqtree_{}.sh".format(output_prefix)
    nexus_out = mrbayes_root / "{}.nexus".format(output_prefix)

    write_fasta(fasta_out, concatenated)
    write_phylip_relaxed(phylip_out, concatenated)
    write_nexus(nexus_out, concatenated, partitions)
    with open(charset_tsv_out, "w", newline="") as handle:
        fieldnames = ["locus", "start", "end", "length"]
        writer = csv.DictWriter(handle, fieldnames=fieldnames, delimiter="\t")
        writer.writeheader()
        for row in partitions:
            writer.writerow(row)
    with open(charset_plain_out, "w") as handle:
        for row in partitions:
            handle.write("charset {} = {}-{};\n".format(row["locus"], row["start"], row["end"]))
    write_charset_nexus(charset_nexus_out, partitions)
    with open(partition_plain_out, "w") as handle:
        for row in partitions:
            handle.write("DNA, {} = {}-{}\n".format(row["locus"], row["start"], row["end"]))
    write_iqtree_script(iqtree_script_out, phylip_out, charset_nexus_out, project_prefix)

    return {
        "loci_concatenated": len(files),
        "taxa_count": len(taxa_order) if taxa_order else 0,
        "supermatrix_length": len(next(iter(concatenated.values()))) if concatenated else 0,
        "supermatrix_fasta": str(fasta_out),
        "supermatrix_phylip": str(phylip_out),
        "supermatrix_nexus": str(nexus_out),
        "charset_tsv": str(charset_tsv_out),
        "charset_file": str(charset_plain_out),
        "charset_nexus_file": str(charset_nexus_out),
        "partition_file": str(partition_plain_out),
        "iqtree_script": str(iqtree_script_out),
        "analysis_output_dir": str(output_root),
        "raxml_iqtree_dir": str(raxml_root),
        "mrbayes_dir": str(mrbayes_root),
    }


