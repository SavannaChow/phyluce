        "report_dir": report_dir,
        "r1": sample_dir / "{}_trimmed_R1.fastq".format(sample),
        "r2": sample_dir / "{}_trimmed_R2.fastq".format(sample),
        "html": report_dir / "{}.fastp.html".format(sample),
        "json": report_dir / "{}.fastp.json".format(sample),
    }


def build_fastp_command(sample, raw_pair, trimmed_root, fastp_path, threads_per_job):
    r1, r2 = raw_pair
    outputs = fastp_outputs(trimmed_root, sample)
    command = [
        fastp_path,
        "--overrepresentation_analysis",
        "--detect_adapter_for_pe",
        "--thread",
        str(threads_per_job),
        "-i",
        str(r1),
        "-I",
        str(r2),
        "-o",
        str(outputs["r1"]),
        "-O",
        str(outputs["r2"]),
        "-h",
        str(outputs["html"]),
        "-j",
        str(outputs["json"]),
    ]
    return command, outputs


def run_fastp(sample, raw_pair, trimmed_root, fastp_path, threads_per_job, logger, log_root):
    command, outputs = build_fastp_command(
        sample, raw_pair, trimmed_root, fastp_path, threads_per_job
    )
    outputs["sample_dir"].mkdir(parents=True, exist_ok=True)
    outputs["report_dir"].mkdir(parents=True, exist_ok=True)
    if outputs["r1"].exists() and outputs["r2"].exists():
        logger.info(
            "Skipping fastp for {}; trimmed FASTQ pair already exists.".format(
                sample
            )
        )
        return False
    if outputs["r1"].exists() or outputs["r2"].exists():
        raise RuntimeError(
            "Incomplete fastp output for sample {}. Remove the partial trimmed "
            "sample directory before rerunning: {}".format(
                sample, outputs["sample_dir"]
            )
        )
    logger.info("Running fastp for {}".format(sample))
    stream_process(
        command,
        logger,
        log_path=log_root / "fastp.{}.log".format(sample),
    )
    return True


def concurrency_from_threads(total_threads, per_job, override):
    if override is not None:
        return max(1, override)
    return max(1, total_threads // per_job)


def run_fastp_for_samples(samples, trimmed_root, fastp_path, total_threads, threads_per_job, max_jobs, logger, log_root):
    jobs = concurrency_from_threads(total_threads, threads_per_job, max_jobs)
    with concurrent.futures.ThreadPoolExecutor(max_workers=jobs) as executor:
        futures = [
            executor.submit(
                run_fastp,
                sample,
                raw_pair,
                trimmed_root,
                fastp_path,
                threads_per_job,
                logger,
                log_root,
            )
            for sample, raw_pair in samples.items()
        ]
        for future in concurrent.futures.as_completed(futures):
            future.result()


def fasta_lengths(fasta_path):
    lengths = []
    current = 0
    with open(fasta_path) as handle:
        for line in handle:
            line = line.strip()
            if not line:
                continue
            if line.startswith(">"):
                if current:
                    lengths.append(current)
                current = 0
            else:
                current += len(line)
    if current:
        lengths.append(current)
    return lengths


def nx_from_lengths(lengths, fraction):
    if not lengths:
        return 0
    target = sum(lengths) * fraction
    running = 0
    for length in sorted(lengths, reverse=True):
        running += length
        if running >= target:
            return length
    return 0


def summarize_contigs(sample, assembly_root):
    contigs = Path(assembly_root) / sample / "contigs.fasta"
    lengths = fasta_lengths(contigs)
    total_size = sum(lengths)
    return OrderedDict(
        [
            ("Sample", sample),
            ("Contigs path", str(contigs)),
            ("Total size", total_size),
            ("Number of contigs", len(lengths)),
            ("N50", nx_from_lengths(lengths, 0.5)),
            ("N90", nx_from_lengths(lengths, 0.9)),
            ("Longest contig", max(lengths) if lengths else 0),
        ]
    )


def write_contig_summary(sample, assembly_root):
    summary = summarize_contigs(sample, assembly_root)
    sample_dir = Path(assembly_root) / sample
    summary_path = sample_dir / "{}.contigs.summary.tsv".format(sample)
    with open(summary_path, "w") as handle:
        handle.write("\t".join(summary.keys()) + "\n")
        handle.write("\t".join(str(value) for value in summary.values()) + "\n")
    return summary


def write_spades_summary_table(samples, assembly_root, logger, write_sample_summaries=True):
    if write_sample_summaries:
        summaries = [write_contig_summary(sample, assembly_root) for sample in samples]
    else:
        summaries = [summarize_contigs(sample, assembly_root) for sample in samples]
    if not summaries:
        return
    summary_path = Path(assembly_root) / "assembly_summary.tsv"
    with open(summary_path, "w") as handle:
        handle.write("\t".join(summaries[0].keys()) + "\n")
        for summary in summaries:
            handle.write("\t".join(str(value) for value in summary.values()) + "\n")
    logger.info("Wrote SPAdes assembly summary: {}".format(summary_path))


def cleanup_spades_sample_dir(sample_out, logger):
    sample_out = Path(sample_out)
    if not sample_out.is_dir():
        return
    removed = 0
    for path in sorted(sample_out.iterdir()):
        if path.name in SPADES_KEEP_FILES:
            continue
        if path.is_dir() and not path.is_symlink():
            shutil.rmtree(path)
        else:
            path.unlink()
        removed += 1
    logger.info(
        "Cleaned SPAdes temporary files in {} (removed {} items; kept {}).".format(
            sample_out,
            removed,
            ", ".join(sorted(SPADES_KEEP_FILES)),
        )
    )


def spades_tmp_dir_for_sample(spades_tmp_root, assembly_root, sample):
    if spades_tmp_root is None:
        return None
    return Path(spades_tmp_root) / Path(assembly_root).parent.name / sample


def require_sudo_for_fstrim(logger, log_root):
    logger.info("Scratch-disk fstrim is enabled. Ensure you have sudo credentials ready.")
    stream_process(
        ["sudo", "-v"],
        logger,
        log_path=log_root / "sudo_fstrim_preauth.log",
    )


def start_sudo_keepalive(logger, log_root, interval_seconds=60):
    stop_event = threading.Event()

    def keepalive():
        while not stop_event.wait(interval_seconds):
            result = subprocess.run(
                ["sudo", "-n", "-v"],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
            )
            if result.returncode != 0:
                logger.info(
                    "sudo credential refresh failed; the next fstrim may require re-authentication."
                )
                return

    thread = threading.Thread(target=keepalive, name="sudo-keepalive", daemon=True)
    thread.start()
    logger.info("Started sudo keepalive for scratch-disk fstrim.")
    return stop_event, thread


def stop_sudo_keepalive(stop_event, thread, logger):
    stop_event.set()
    thread.join(timeout=1)
    logger.info("Stopped sudo keepalive for scratch-disk fstrim.")


def run_fstrim_for_spades_scratch(spades_tmp_root, logger, log_root):
    try:
        stream_process(
            ["sudo", "-n", "fstrim", "-v", str(spades_tmp_root)],
            logger,
            log_path=log_root / "fstrim_spades_scratch.log",
        )
    except RuntimeError as exc:
        logger.info(
            "Skipping fstrim for {} and continuing: {}".format(
                spades_tmp_root,
                exc,
            )
        )
        return False
    return True


def run_spades(sample, trimmed_root, assembly_root, spades_path, per_job_threads, memory_gb, cov_cutoff, spades_tmp_root, cleanup_temp, logger, log_root):
    outputs = fastp_outputs(trimmed_root, sample)
    sample_out = assembly_root / sample
    contigs = sample_out / "contigs.fasta"
    if contigs.exists():
        if cleanup_temp:
            cleanup_spades_sample_dir(sample_out, logger)
        logger.info(
            "Skipping SPAdes for {}; contigs.fasta already exists.".format(sample)
        )
        return False
    sample_out.mkdir(parents=True, exist_ok=True)
    spades_tmp_dir = spades_tmp_dir_for_sample(spades_tmp_root, assembly_root, sample)
    if spades_tmp_dir is not None:
        spades_tmp_dir.mkdir(parents=True, exist_ok=True)
    command = build_spades_command(
        sample,
        trimmed_root,
        assembly_root,
        spades_path,
        per_job_threads,
        memory_gb,
        cov_cutoff,
        spades_tmp_dir,
    )
    logger.info("Running SPAdes for {}".format(sample))
    stream_process(
        command,
        logger,
        log_path=log_root / "spades.{}.log".format(sample),
    )
    if cleanup_temp and contigs.exists():
        cleanup_spades_sample_dir(sample_out, logger)
    return True


def build_spades_command(sample, trimmed_root, assembly_root, spades_path, per_job_threads, memory_gb, cov_cutoff, spades_tmp_dir=None):
    outputs = fastp_outputs(trimmed_root, sample)
    sample_out = assembly_root / sample
    command = [
        spades_path,
        "-t",
        str(per_job_threads),
        "-m",
        str(memory_gb),
        "--cov-cutoff",
        str(cov_cutoff),
        "--careful",
        "-1",
        str(outputs["r1"]),
        "-2",
        str(outputs["r2"]),
        "-o",
        str(sample_out),
    ]
    if spades_tmp_dir is not None:
        command.extend(["--tmp-dir", str(spades_tmp_dir)])
    return command


def run_spades_for_samples(samples, trimmed_root, assembly_root, spades_path, total_threads, per_job_threads, max_jobs, memory_gb, cov_cutoff, spades_tmp_root, cleanup_temp, fstrim_scratch, logger, log_root):
    jobs = concurrency_from_threads(total_threads, per_job_threads, max_jobs)
    sudo_keepalive = None
    if fstrim_scratch:
        if spades_tmp_root is None:
            raise RuntimeError("Scratch-disk fstrim requires a configured SPAdes temporary directory.")
        if jobs != 1:
            raise RuntimeError("Scratch-disk fstrim requires Maximum concurrent SPAdes jobs = 1.")
        require_sudo_for_fstrim(logger, log_root)
        sudo_keepalive = start_sudo_keepalive(logger, log_root)
    if jobs == 1:
        try:
            for sample in samples:
                ran_spades = run_spades(
                    sample,
                    trimmed_root,
                    assembly_root,
                    spades_path,
                    per_job_threads,
                    memory_gb,
                    cov_cutoff,
                    spades_tmp_root,
                    cleanup_temp,
                    logger,
                    log_root,
                )
                if fstrim_scratch and ran_spades:
                    run_fstrim_for_spades_scratch(spades_tmp_root, logger, log_root)
            write_spades_summary_table(
                samples,
                assembly_root,
                logger,
                write_sample_summaries=not cleanup_temp,
            )
            return
        finally:
            if sudo_keepalive is not None:
                stop_sudo_keepalive(sudo_keepalive[0], sudo_keepalive[1], logger)
    with concurrent.futures.ThreadPoolExecutor(max_workers=jobs) as executor:
        futures = [
            executor.submit(
                run_spades,
                sample,
                trimmed_root,
                assembly_root,
                spades_path,
                per_job_threads,
                memory_gb,
                cov_cutoff,
                spades_tmp_root,
                cleanup_temp,
                logger,
                log_root,
            )
            for sample in samples
        ]
        for future in concurrent.futures.as_completed(futures):
            future.result()
    write_spades_summary_table(
        samples,
        assembly_root,
        logger,
        write_sample_summaries=not cleanup_temp,
    )


def run_alignment_for_samples(samples, assembly_root, alignment_root, probes_path, minimap2_path, threads, logger, log_root):
